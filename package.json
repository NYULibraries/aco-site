{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "format:blade": "blade-formatter --write 'resources/**/*.blade.php'"
    },
    "dependencies": {
        "autoprefixer": "10.4.20",
        "concurrently": "9.0.1",
        "laravel-vite-plugin": "2.0",
        "sass-embedded": "1.93.2",
        "vite": "^7.3.5"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.9.5"
    },
    "devDependencies": {
        "blade-formatter": "1.44.2"
    },
    "overrides": {
        "picomatch": ">=4.0.4",
        "lodash": ">=4.17.23",
        "postcss": ">=8.5.23",
        "minimatch": ">=9.0.7",
        "brace-expansion": ">=2.1.4",
        "fast-uri": ">=3.1.5",
        "shell-quote": ">=1.9.0",
        "nanoid": ">=3.3.18"
    },
    "allowScripts": {
        "@parcel/watcher@2.6.0": true,
        "core-js-pure@3.50.0": true,
        "esbuild@0.28.2": true
    }
}
